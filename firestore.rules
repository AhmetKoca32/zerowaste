rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isActiveAdmin() {
      return request.auth != null
        && exists(adminPath())
        && get(adminPath()).data.get('disabled', false) != true;
    }

    function adminRole() {
      return get(adminPath()).data.keys().hasAny(['role'])
        && get(adminPath()).data.role is string
        && get(adminPath()).data.role != ''
          ? get(adminPath()).data.role.lower()
          : 'owner';
    }

    function isSuperAdmin() {
      return isActiveAdmin()
        && (adminRole() == 'superadmin' || adminRole() == 'super_admin');
    }

    function canManageRecipes() {
      return isActiveAdmin()
        && (
          adminRole() == 'superadmin'
          || adminRole() == 'super_admin'
          || adminRole() == 'owner'
          || adminRole() == 'editor'
        );
    }

    function canModerate() {
      return isActiveAdmin()
        && (
          adminRole() == 'superadmin'
          || adminRole() == 'super_admin'
          || adminRole() == 'owner'
          || adminRole() == 'moderator'
        );
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if canManageRecipes();
    }

    match /posts/{postId} {
      allow create: if true;
      allow read: if true;
      allow update: if canModerate()
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['leaderboardOptIn']);
      allow delete: if isSuperAdmin();
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /admins/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if false;
    }
  }
}
