rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function adminPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isActiveAdmin() {
      return request.auth != null
        && exists(adminPath())
        && get(adminPath()).data.get('disabled', false) != true;
    }

    function adminRole() {
      return get(adminPath()).data.keys().hasAny(['role'])
        && get(adminPath()).data.role is string
        && get(adminPath()).data.role != ''
          ? get(adminPath()).data.role.lower()
          : 'owner';
    }

    function isSuperAdmin() {
      return isActiveAdmin()
        && (adminRole() == 'superadmin' || adminRole() == 'super_admin');
    }

    function canManageRecipes() {
      return isActiveAdmin()
        && (
          adminRole() == 'superadmin'
          || adminRole() == 'super_admin'
          || adminRole() == 'owner'
          || adminRole() == 'editor'
        );
    }

    function canModerate() {
      return isActiveAdmin()
        && (
          adminRole() == 'superadmin'
          || adminRole() == 'super_admin'
          || adminRole() == 'owner'
          || adminRole() == 'moderator'
        );
    }

    // claimedByUid: immutable once set; empty → first claim by auth.uid only.
    function claimedByUidOkOnUpdate() {
      return !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['claimedByUid'])
        || (
          (!('claimedByUid' in resource.data)
            || resource.data.claimedByUid == null
            || resource.data.claimedByUid == '')
          && request.auth != null
          && request.resource.data.claimedByUid == request.auth.uid
        );
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if canManageRecipes();
    }

    match /posts/{postId} {
      allow create: if true;
      allow read: if true;
      allow update: if canModerate()
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['leaderboardOptIn']);
      allow delete: if isSuperAdmin();
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if canModerate();
    }

    // Plan B: nickname uniqueness via claimedByUid (synced with admin deploy).
    match /user_stats/{nickname} {
      allow read: if true;

      // Client must claim as self; canModerate may create without claim (2A upsert).
      allow create: if canModerate() || (
        request.auth != null
        && request.resource.data.nickname == nickname
        && request.resource.data.claimedByUid == request.auth.uid
        && (
          !('totalPoints' in request.resource.data)
          || request.resource.data.totalPoints == 0
        )
        && (
          !('status' in request.resource.data)
          || request.resource.data.status == 'active'
        )
      );

      allow update: if request.auth != null
        && claimedByUidOkOnUpdate()
        && (
          canModerate()
          || (
            !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny(['totalPoints', 'status', 'reason', 'reasonEn', 'nickname'])
            && (
              resource.data.claimedByUid == request.auth.uid
              || (
                (!('claimedByUid' in resource.data)
                  || resource.data.claimedByUid == null
                  || resource.data.claimedByUid == '')
                && request.resource.data.claimedByUid == request.auth.uid
              )
            )
          )
        );

      allow delete: if canModerate();
    }

    // Legacy — no new writes.
    match /user_profiles/{nickname} {
      allow read: if true;
      allow write: if false;
    }

    match /admins/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if false;
    }
  }
}
